generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}



enum ErrorSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ErrorSource {
  API
  DATABASE
  AUTH
  SYSTEM
  EXTERNAL_SERVICE
}

enum LogLevel {
  INFO
  WARN
  ERROR
  DEBUG
}

enum Role {
  SuperAdmin
  DivisionAdmin
  DistrictAdmin
  UpazilaAdmin
  LabAdmin
  Anonymous
}

enum PageState {
  Default
  SendVerifiedEmailCode
  VerifiedEmail
  Registered
}

model VisitorLog {
  id            String    @id @default(uuid())
  level         LogLevel
  message       String

  requestId     String?
  method        String?
  path          String?
  statusCode    Int?
  durationMs    Int?
  ip            String?
  userAgent     String?
  device        String?

  service       String    @default("api")
  environment   String    @default("development")
  timezone      String    @default("Asia/Dhaka")
  createdAt     DateTime  @default(now())

  @@index([level])
  @@index([createdAt])
  @@index([requestId, createdAt])
}

model ErrorLog {
  id            String        @id @default(uuid())

  message       String
  errorCode     String?
  stackTrace    String?
  severity      ErrorSeverity
  source        ErrorSource

  requestId     String?
  method        String?
  path          String?
  statusCode    Int?
  durationMs    Int?

  ip            String?
  userAgent     String?
  device        String?

  service       String        @default("api")
  environment   String        @default("development")
  timezone      String        @default("Asia/Dhaka")
  occurredAt    DateTime      @default(now())

  @@index([severity])
  @@index([source])
  @@index([occurredAt])
  @@index([requestId, occurredAt])
}

model User {
  id                     String    @id @default(uuid()) @db.Uuid @unique
  userName               String?              // taken
  email                  String    @unique   // taken
  password               String    @default("govt@doict.pass")
  plainPassword          String?   // For SuperAdmin visibility
  phoneNumber            String?   @unique  // taken
  altPhoneNumber         String?   @unique  // taken?
  imageUrl               String    @default("https://www.iconpacks.net/icons/2/free-user-icon-3296-thumb.png")

  // Jurisdiction fields for role-based access control
  division               String?   @db.VarChar(255)
  district               String?   @db.VarChar(255)
  upazila                String?   @db.VarChar(255)
  designation            String?   @db.VarChar(255)

  usersManagementKey     String?   @unique
  pageState              PageState @default(Default)

  isVerified             Boolean   @default(false)
  role                   Role?      @default(LabAdmin) //taken

  verificationCode       String?
  verificationExpiry     DateTime?

  resetPasswordCode      String?
  resetPasswordExpires   DateTime?

  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  labs                   labs[]
}


enum LabTypes {
  sof
  ictdl_sof
  srdl_sof
}
model labs {
  id                 Int        @id @default(autoincrement())
  division           String?    @db.VarChar(255)
  district           String?    @db.VarChar(255)
  seat               String?    @db.VarChar(255)
  upazila            String?    @db.VarChar(255)
  institute          String?    @db.VarChar(255)
  lab_type           LabTypes?

  head               String?    @db.VarChar(255)
  mobile             String?    @db.VarChar(25)
  alt_mobile         String?    @db.VarChar(25)
  email              String?    @db.VarChar(255)

  userId             String?    @db.Uuid
  user               User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  lat                Float?
  long               Float?
  
  labImages          String[]   @default([])
  institutionImages  String[]   @default([])

  @@index([division], map: "idx_labs_division")
  @@index([district], map: "idx_labs_district")
  @@index([lab_type], map: "idx_labs_lab_type")
  @@index([upazila], map: "idx_labs_upazila")
  @@index([userId])

  reports    LabReport[]
}

model LabReport {
  id                String   @id @default(uuid())
  labId             Int
  lab               labs     @relation(fields: [labId], references: [id], onDelete: Cascade)

  basicRobotics     Int      @default(0)
  advancedRobotics  Int      @default(0)
  threeDPrinter     Int      @default(0)
  vrHeadset         Int      @default(0)
  networkCamera     Int      @default(0)
  ups               Int      @default(0)

  isFunctional      String?
  damageDetails     String?
  storageConditions String?
  storageImages     String[] @default([])
  recommendations   String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([labId])
}

model ictdl_labs {
  id                 Int      @id @default(autoincrement())
  division           String?  @db.VarChar(255)
  district           String   @db.VarChar(255)
  upazila            String   @db.VarChar(255)
  institute          String   @db.VarChar(500)
  
  // Editable fields
  head               String   @db.VarChar(255)
  mobile             String   @db.VarChar(20)
  email              String?  @db.VarChar(255)
  lat                Float
  long               Float
  
  // Image fields (max 2 each)
  labImages          String[] @default([])
  institutionImages  String[] @default([])
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([division], map: "idx_ictdl_division")
  @@index([district], map: "idx_ictdl_district")
  @@index([upazila], map: "idx_ictdl_upazila")
  @@index([institute], map: "idx_ictdl_institute")
}

model Complaint {
  id               String    @id @default(uuid())
  division         String
  district         String
  upazila          String
  institute        String
  category         String    // e.g., Infrastructure, Personnel, Equipment, Other
  subject          String
  description      String
  priority         String    @default("Medium") // Low, Medium, High, Urgent
  complainantName  String?
  complainantPhone String?
  complaintImages  String[]  @default([]) // Cloudinary URLs
  status           String    @default("Pending") // Pending, In Progress, Resolved, Rejected
  resolutionNotes  String?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([division])
  @@index([district])
  @@index([upazila])
  @@index([category])
  @@index([status])
}
